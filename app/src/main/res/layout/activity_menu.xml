<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Menu" >


    <ImageView
        android:id="@+id/hook_shot"
        android:layout_width="173dp"
        android:layout_height="90dp"
        android:layout_below="@id/cut_shot"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/hookshot" />

    <ImageView
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:src="@drawable/selcetop" />

    <ImageView
        android:id="@+id/straight_drive"
        android:layout_width="173dp"
        android:layout_height="90dp"
        android:layout_below="@id/top"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/sdrive" />

    <ImageView
        android:id="@+id/cover_drive"
        android:layout_width="161dp"
        android:layout_height="88dp"
        android:layout_below="@id/top"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="30dp"
        android:layout_toRightOf="@+id/straight_drive"
        android:src="@drawable/coverdrive" />

    <ImageView
        android:id="@+id/on_drive"
        android:layout_width="161dp"
        android:layout_height="88dp"
        android:layout_below="@id/cover_drive"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="30dp"
        android:layout_toRightOf="@+id/pull_shot"
        android:src="@drawable/ondrive" />

    <ImageView
        android:id="@+id/flick_shot"
        android:layout_width="161dp"
        android:layout_height="88dp"
        android:layout_below="@id/on_drive"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="30dp"
        android:layout_toRightOf="@+id/cut_shot"
        android:src="@drawable/flickshot" />

    <ImageView
        android:id="@+id/sweep_shot"
        android:layout_width="161dp"
        android:layout_height="88dp"
        android:layout_below="@id/flick_shot"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="30dp"
        android:layout_toRightOf="@+id/hook_shot"
        android:src="@drawable/sweepshot" />

    <ImageView
        android:id="@+id/pull_shot"
        android:layout_width="173dp"
        android:layout_height="86dp"
        android:layout_below="@id/straight_drive"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/pullshot" />

    <ImageView
        android:id="@+id/cut_shot"
        android:layout_width="176dp"
        android:layout_height="86dp"
        android:layout_below="@id/pull_shot"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/cutshot" />


    <Button
        android:id="@+id/straight_drive_bt"
        android:layout_width="173dp"
        android:layout_height="90dp"
        android:layout_below="@id/top"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="30dp"
        android:background="#00FFFFFF" />

    <Button
        android:id="@+id/cover_drive_bt"
        android:layout_width="161dp"
        android:layout_height="88dp"
        android:layout_below="@id/top"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="30dp"
        android:layout_toRightOf="@+id/straight_drive"
        android:background="#00FFFFFF" />

    <Button
        android:id="@+id/pull_shot_bt"
        android:layout_width="173dp"
        android:layout_height="86dp"
        android:layout_below="@id/straight_drive"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="30dp"
        android:background="#00FFFFFF" />

    <Button
        android:id="@+id/on_drive_bt"
        android:layout_width="161dp"
        android:layout_height="88dp"
        android:layout_below="@id/cover_drive"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="30dp"
        android:layout_toRightOf="@+id/pull_shot"
        android:background="#00FFFFFF" />


    <Button
        android:id="@+id/cut_shot_bt"
        android:layout_width="176dp"
        android:layout_height="86dp"
        android:layout_below="@id/pull_shot"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="30dp"
        android:background="#00FFFFFF" />

    <Button
        android:id="@+id/flick_shot_bt"
        android:layout_width="161dp"
        android:layout_height="88dp"
        android:layout_below="@id/on_drive"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="30dp"
        android:layout_toRightOf="@+id/cut_shot"
        android:background="#00FFFFFF" />

    <Button
        android:id="@+id/hook_shot_bt"
        android:layout_width="173dp"
        android:layout_height="90dp"
        android:layout_below="@id/cut_shot"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="30dp"
        android:background="#00FFFFFF" />


    <Button
        android:id="@+id/sweep_shot_bt"
        android:layout_width="161dp"
        android:layout_height="88dp"
        android:layout_below="@id/flick_shot"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="30dp"
        android:layout_toRightOf="@+id/hook_shot"
        android:background="#00FFFFFF" />

</RelativeLayout>